# Copy to backend/.env for local development. On Vercel, set these in Project Settings -> Environment Variables
# (or with scripts/push_env_to_vercel.py). Never commit the real values.

# --- Required ---
# Voice agents, Developer and Tester.
GEMINI_API_KEY=
# https://<project>.supabase.co
SUPABASE_URL=
# service_role key: server only, bypasses row-level security.
SUPABASE_SERVICE_KEY=

# --- Optional features ---
# Cutu, the guide bot on the About page, uses its own key. Without it Cutu is disabled.
GEMINI_API_KEY_BOT=
# Deploy feature: a classic GitHub token with the `repo` scope.
GITHUB_TOKEN=
# Deploy feature: a Vercel access token. NOT called VERCEL_TOKEN: Vercel reserves names starting with VERCEL_ and its
# dashboard will not let you set one. (An old local VERCEL_TOKEN line still works.)
DEPLOY_VERCEL_TOKEN=

# --- Optional tuning (the defaults are fine) ---
LIVE_MODEL=gemini-3.8-live
TEXT_MODEL=gemini-3.5-flash
FALLBACK_MODEL=gemini-3.5-flash-lite
THINKING_LEVEL=low

# SUPABASE_ANON_KEY is not used: the browser never talks to Supabase.
